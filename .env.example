# ============================================================
# AILab Ops Copilot — environment template
# Copy to `.env` (or just `export` these) and edit as needed.
# Everything here has a working default; the project runs with a
# fully offline, deterministic mock LLM out of the box.
# ============================================================

# ---------- Synthetic data ----------
# All dataset content is generated locally. No real platform data is ever read.
AILAB_DATA_DIR=./data/generated
AILAB_SEED=20260929
AILAB_N_JOBS=400

# ---------- LLM backend ----------
# mock   : built-in deterministic, offline "reasoner" (default, no network, no cost)
# openai : any OpenAI-compatible /chat/completions endpoint (vLLM, SGLang, one-api, ...)
AILAB_LLM_BACKEND=mock
AILAB_LLM_MODEL=mock-diagnoser-v1
AILAB_LLM_BASE_URL=http://127.0.0.1:8001/v1
AILAB_LLM_API_KEY=EMPTY
AILAB_LLM_TIMEOUT_S=60
# Simulated think time per model call, in milliseconds. 0 keeps the test suite
# fast, but a BENCHMARK should set ~400: with an instant model there is never
# more than one call in flight, so the concurrency gate is unobservable and the
# benchmark measures nothing. See the benchmark section of the README.
AILAB_LLM_LATENCY_MS=0

# ---------- Serving / concurrency control ----------
# The single most important knob in the whole project: how many model calls
# may be in flight at once. Protects the upstream inference service.
AILAB_UPSTREAM_CONCURRENCY=8
AILAB_QUEUE_MAXSIZE=64
AILAB_QUEUE_TIMEOUT_S=30

# ---------- Rate limits & budget ----------
AILAB_USER_QPS=2
AILAB_TENANT_CONCURRENCY=16
AILAB_TENANT_TOKEN_PER_MIN=200000        # 0 = unlimited
AILAB_TENANT_COST_PER_DAY_USD=5.0        # 0 = unlimited
AILAB_PRICE_INPUT_PER_MTOK=0.15          # USD per 1M input tokens
AILAB_PRICE_OUTPUT_PER_MTOK=0.60         # USD per 1M output tokens

# ---------- Cache ----------
AILAB_SEMANTIC_CACHE_ENABLED=true
AILAB_SEMANTIC_CACHE_TTL_S=900
AILAB_SEMANTIC_CACHE_THRESHOLD=0.86

# ---------- Server ----------
AILAB_HOST=0.0.0.0
AILAB_PORT=8080
AILAB_LOG_LEVEL=INFO
