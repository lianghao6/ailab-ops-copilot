# V2 online first: set a real compatible endpoint, model and credential.
AILAB_MODEL_MODE=online
AILAB_LLM_BASE_URL=https://your-gateway.example/v1
AILAB_LLM_MODEL=your-tool-calling-model
AILAB_LLM_API_KEY=
AILAB_LLM_TIMEOUT_S=60

# Offline alternative: explicitly set AILAB_MODEL_MODE=replay.
# No API key or network required; exact recorded inputs only.
# Fixtures are manually authored simulations, not live model output.
AILAB_MODEL_REPLAY_PATH=data/v2/replays/investigations.jsonl

# Model admission, queue and tenant controls
AILAB_UPSTREAM_CONCURRENCY=8
AILAB_QUEUE_MAXSIZE=64
AILAB_QUEUE_TIMEOUT_S=30
AILAB_USER_QPS=2
AILAB_TENANT_CONCURRENCY=16
# Set the token or cost ceiling to 0 to disable it.
AILAB_TENANT_TOKEN_PER_MIN=200000
AILAB_TENANT_COST_PER_DAY_USD=5.0
AILAB_PRICE_INPUT_PER_MTOK=0.15
AILAB_PRICE_OUTPUT_PER_MTOK=0.60
AILAB_AGENT_MAX_STEPS=8

AILAB_HOST=127.0.0.1
AILAB_PORT=8080
AILAB_LOG_LEVEL=INFO

# Legacy demo/ask/eval utilities only; these do not select the V2 backend.
AILAB_LLM_BACKEND=mock
AILAB_LLM_LATENCY_MS=0
AILAB_DATA_DIR=./data/generated
AILAB_SEED=20260929
AILAB_N_JOBS=400
# V2 does not cache session-bound cited reports.
AILAB_SEMANTIC_CACHE_ENABLED=false
